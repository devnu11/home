{{- /*
  Names in ~/.claude/skills that the next apply deletes, one per line:
  exact_skills removes every entry the submodule has no folder for. `synced`
  is kept, as .chezmoiignore leaves it out; keep the two lists in step.

  Every literal newline here is trimmed, and names end in printf's "\n": on a
  CRLF checkout (Windows) a literal newline would add a stray "\r". `base`
  splits only on "/", while glob returns "\" paths on Windows.
*/ -}}
{{- $src := joinPath .chezmoi.sourceDir "private_dot_claude/exact_skills" -}}
{{- range glob (joinPath .chezmoi.destDir ".claude/skills/*") -}}
{{-   $name := regexReplaceAll `.*[/\\]` . "" -}}
{{-   if and (ne $name "synced") (not (stat (joinPath $src $name))) -}}
{{-     printf "%s\n" $name -}}
{{-   end -}}
{{- end -}}
