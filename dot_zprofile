# Managed by chezmoi. Edit the source: `chezmoi edit ~/.zprofile`
# Login shells. Runs after ~/.zshenv, and after macOS /etc/zprofile has run
# path_helper — so env.sh is re-sourced to put our PATH entries back in front.

# Homebrew: Apple Silicon, Intel macOS, and Linuxbrew all differ.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
	if [ -x "$_brew" ]; then
		eval "$("$_brew" shellenv)"
		break
	fi
done
unset _brew

[ -f "$HOME/.shell/env.sh" ] && . "$HOME/.shell/env.sh"
[ -f "$HOME/.zprofile.local" ] && . "$HOME/.zprofile.local"
