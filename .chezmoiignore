# Paths here are TARGET paths (relative to ~), not source filenames.
# Anything listed is never created or updated in the home directory.

# Repo furniture that lives in the source dir but is not a dotfile.
README.md
LICENSE
handy
tests

# Anthropic syncs this bucket from the account; it is machine state, not config.
.claude/skills/synced

# The skills submodule's own furniture: only the skill folders belong in
# ~/.claude/skills. Dot-files there (.github, .team, ...) chezmoi skips itself.
.claude/skills/README.md
.claude/skills/LICENSE
.claude/skills/install.sh
.claude/skills/tests

{{ if ne .chezmoi.os "windows" }}
# PowerShell profiles and the cmd.exe setup are Windows-only.
Documents
.cmdrc.cmd
.config/cmd
AppData
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# Karabiner-Elements is macOS-only.
.config/karabiner
{{ end }}

{{ if eq .chezmoi.os "windows" }}
# No zsh on Windows; Git Bash reads .bashrc.
.zshrc
.zprofile
.zshenv
{{ end }}

{{ if eq .profile "work" }}
# Work machines keep the team's ~/.bashrc, which sources ~/my.bashrc.
.bashrc
{{ else }}
my.bashrc
{{ end }}

# A target that is a symlink is shared with someone or something else (a
# team-wide ~/.bashrc, say). Replacing it would break them, so leave it be.
# dot_bash_profile still loads our shell setup when ~/.bashrc is skipped.
{{ range .existingTargets -}}
{{   $info := lstat (joinPath $.chezmoi.destDir .) -}}
{{   if and $info (eq $info.type "symlink") }}
{{ . }}
{{-  end }}
{{ end -}}
