# Managed by chezmoi. Generated from .chezmoidata/aliases.yaml; add aliases
# there, not here. Sourced from interactive.sh. Every bash/zsh alias is here;
# interactive.sh holds only functions.
{{ range $name, $alias := .aliases -}}
{{   $command := includeTemplate "alias-command" (dict "alias" $alias "shell" "sh") -}}
{{   if $command -}}
alias {{ $name }}='{{ $command | replace "'" "'\\''" }}'
{{   end -}}
{{ end -}}
