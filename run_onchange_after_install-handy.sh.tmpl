{{ if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Re-runs only when handy's entry points change.
# pyproject.toml hash: {{ include "handy/pyproject.toml" | sha256sum }}

# Note: uv installs into $HOME/.local/bin regardless of chezmoi's --destination,
# so applying to an alternate destination still writes to the real home.
HANDY="{{ .chezmoi.sourceDir }}/handy"

command -v uv >/dev/null 2>&1 || {
	echo "handy: uv not installed, skipping (see https://docs.astral.sh/uv/)" >&2
	exit 0
}
[ -f "$HANDY/pyproject.toml" ] || {
	echo "handy: submodule not checked out, skipping (git submodule update --init)" >&2
	exit 0
}

echo "handy: installing entry points into ~/.local/bin"
uv tool install --force --editable "$HANDY"
{{ end -}}
