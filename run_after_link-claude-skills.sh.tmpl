{{ if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Symlink skills from the claude-skills external into ~/.claude/skills.
# Runs on every apply; cheap and idempotent. The repo's own install.sh does
# the work, so the two stay in step and the repo remains usable without
# chezmoi.
#
# `chezmoi diff` shows only this wrapper, never what install.sh will change.
# install.sh lives in ~/code/claude-skills (cloned from
# github.com/devnu11/claude-skills by .chezmoiexternal.toml). Preview it with:
#   CLAUDE_SKILLS_DIR=~/.claude/skills ~/code/claude-skills/install.sh --dry-run

REPO="{{ .chezmoi.destDir }}/code/claude-skills"

# install.sh defaults to $HOME/.claude/skills; be explicit so that applying to
# an alternate --destination links there instead of the real home.
CLAUDE_SKILLS_DIR="{{ .chezmoi.destDir }}/.claude/skills"
export CLAUDE_SKILLS_DIR

[ -x "$REPO/install.sh" ] || exit 0
exec "$REPO/install.sh"
{{ end -}}
